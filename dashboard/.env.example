# =============================================================================
# 대시보드 환경변수 템플릿
#
# - Vercel: Project → Settings → Environment Variables 에 등록
# - 로컬 개발: 이 파일을 `.env.local` 로 복사한 뒤 실제 값 입력
#
# ⚠️ VITE_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출됩니다.
#    반드시 Supabase **anon** 키를 사용하고, service_role 키는 절대 넣지 마십시오.
# =============================================================================

# Supabase REST 엔드포인트 (끝의 /rest/v1/ 는 있어도 없어도 자동 보정됨)
VITE_SUPABASE_URL=https://your-project.supabase.co/rest/v1/

# Supabase anon(public) API 키
VITE_SUPABASE_KEY=your-supabase-anon-key-here

# 측정 데이터가 적재되는 통합 테이블명 (모든 지점 공용, 변경할 일 거의 없음)
VITE_SUPABASE_MEASUREMENT_TABLE=measure_logs_v2

# -----------------------------------------------------------------------------
# 참고: 지점(site) 선택은 환경변수가 아니라 접속 URL 파라미터로 결정됩니다.
#   지점 단위 조회 : https://<대시보드주소>/?site=<site_id>
#   기기 단위 조회 : https://<대시보드주소>/?device=<device_id>
#
# 과거 존재하던 VITE_SUPABASE_TABLE(기본값 Samyang_Incheon)은 파라미터 누락 시
# 특정 지점 데이터가 노출되는 문제가 있어 제거되었습니다.
# -----------------------------------------------------------------------------
